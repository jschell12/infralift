{
  "name": "infralift",
  "private": true,
  "version": "0.1.0",
  "license": "BUSL-1.1",
  "description": "Infrastructure as code in your own repository: templates, assessments, and imports that change nothing running, delivered as pull requests.",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter './packages/*' build && pnpm --filter './apps/*' build",
    "lint": "pnpm --filter './apps/*' lint",
    "db:generate": "pnpm --filter @infralift/api db:generate",
    "db:migrate": "pnpm --filter @infralift/api db:migrate",
    "test": "pnpm --filter @infralift/api --filter @infralift/web test"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0"
}
