# Fly.io E2E deployment variables
# Copy to terraform.tfvars and fill in values

region            = "iad"
org               = "personal"
app_name          = "infralift-e2e"
docker_image      = "nginx:alpine"
neon_database_url = "postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/infralift?sslmode=require"
