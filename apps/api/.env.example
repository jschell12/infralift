# Postgres connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/infralift"

# 32-byte hex key for AES-256-GCM encryption of provider tokens at rest.
# Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=""

# Port for the API server
PORT=4000

# Comma-separated origins allowed by CORS (web + dashboard)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
