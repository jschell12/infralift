# GENERATED by infralift: state backend = OpenTofu + Cloudflare R2, encrypted.
#
# State is encrypted client-side before it reaches the bucket. The passphrase
# is TF_VAR_state_passphrase; lose it and the state is unreadable.
#
# The bucket's credentials are variables rather than AWS_ACCESS_KEY_ID, which
# the AWS provider reads for the account this stack builds in. OpenTofu
# evaluates variables in a backend block (1.8 and later), so set
# TF_VAR_state_access_key_id and TF_VAR_state_secret_access_key to an R2 API
# token's S3 credentials.
#
# Bucket, key and endpoint come from backend.r2.hcl (see the .example), so
# the Cloudflare account id stays out of this file:
#   tofu init -backend-config=backend.r2.hcl
#
# Switching to Terraform Cloud is a change to the project in infralift, which
# rewrites this file.

variable "state_passphrase" {
  type      = string
  sensitive = true
}

variable "state_access_key_id" {
  type      = string
  sensitive = true
}

variable "state_secret_access_key" {
  type      = string
  sensitive = true
}

terraform {
  required_version = ">= 1.8"

  backend "s3" {
    access_key                  = var.state_access_key_id
    secret_key                  = var.state_secret_access_key
    region                      = "auto"
    use_path_style              = true
    skip_credentials_validation = true
    skip_region_validation      = true
    skip_requesting_account_id  = true
    skip_metadata_api_check     = true
    skip_s3_checksum            = true
    use_lockfile                = true
  }

  encryption {
    key_provider "pbkdf2" "state" {
      passphrase = var.state_passphrase
    }

    method "aes_gcm" "state" {
      keys = key_provider.pbkdf2.state
    }

    state {
      method   = method.aes_gcm.state
      enforced = true
    }

    plan {
      method   = method.aes_gcm.state
      enforced = true
    }
  }
}
