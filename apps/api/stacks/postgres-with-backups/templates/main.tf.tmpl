# GENERATED by infralift from the postgres-with-backups stack. main.tf and
# backend.tf are rewritten when the project's settings change in infralift;
# modules/ is rewritten when the stack changes. Add your own resources in a
# file of your own in this directory, which infralift never touches.

terraform {
  required_version = ">= 1.6"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

# Credentials come from the environment (AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY, or anything else the AWS SDK reads), never a file.
provider "aws" {
  region = "{{region}}"

  default_tags {
    tags = {
      managed-by        = "infralift"
      infralift-stack   = "postgres-with-backups"
      infralift-project = "{{name}}"
    }
  }
}

module "database" {
  source = "./modules/database"

  name                      = "{{name}}"
  vpc_id                    = "{{vpc_id}}"
  subnet_ids                = [for id in split(",", "{{subnet_ids}}") : trimspace(id)]
  allowed_cidr              = "{{allowed_cidr}}"
  allowed_security_group_id = "{{allowed_security_group_id}}"
  instance_class            = "{{instance_class}}"
  allocated_storage_gb      = {{allocated_storage_gb}}
  engine_version            = "{{engine_version}}"
  backup_retention_days     = {{backup_retention_days}}
}

module "snapshot_exports" {
  source = "./modules/snapshot-exports"

  name           = "{{name}}"
  retention_days = {{export_retention_days}}
}
