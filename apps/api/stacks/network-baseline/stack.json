{
  "slug": "network-baseline",
  "name": "Network baseline (AWS)",
  "version": "1.0.0",
  "description": "A VPC with public and private subnets across 2 or 3 zones, NAT (one shared gateway by default), flow logs to CloudWatch with retention, and the default security group locked down. Estimated cost at the defaults: about $37/month plus traffic, mostly the NAT gateway (us-east-1 list prices, 2026-11-14).",
  "target": {
    "slug": "aws",
    "name": "AWS"
  },
  "deliveries": [
    {
      "slug": "github-actions",
      "name": "GitHub Actions",
      "gitHost": "github"
    }
  ],
  "modules": [
    {
      "name": "vpc",
      "path": "infra/network-baseline/modules/vpc",
      "description": "The VPC, its subnets, internet gateway, NAT gateways and route tables, and the emptied default security group.",
      "anchor": "aws_vpc",
      "inputs": [
        "name",
        "cidr",
        "az_count",
        "single_nat"
      ],
      "outputs": [
        "vpc_id",
        "vpc_cidr",
        "public_subnet_ids",
        "private_subnet_ids",
        "nat_public_ips"
      ]
    },
    {
      "name": "flow-logs",
      "path": "infra/network-baseline/modules/flow-logs",
      "description": "VPC flow logs into a CloudWatch log group with retention, and the IAM role that writes them.",
      "anchor": "aws_flow_log",
      "inputs": [
        "name",
        "vpc_id",
        "retention_days"
      ],
      "outputs": [
        "log_group_name",
        "flow_log_id"
      ]
    }
  ],
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name"
    ],
    "properties": {
      "name": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{2,30}$",
        "description": "Prefix for every resource's name. Lowercase letters, digits and hyphens."
      },
      "region": {
        "type": "string",
        "enum": [
          "us-east-1",
          "us-east-2",
          "us-west-2",
          "ca-central-1",
          "eu-west-1",
          "eu-west-2",
          "eu-central-1",
          "ap-southeast-1",
          "ap-southeast-2",
          "ap-northeast-1"
        ],
        "default": "us-east-1",
        "description": "The AWS region the VPC is built in."
      },
      "cidr": {
        "type": "string",
        "pattern": "^(10\\.[0-9]{1,3}|172\\.(1[6-9]|2[0-9]|3[01])|192\\.168)\\.[0-9]{1,3}\\.0/(1[6-9]|20)$",
        "default": "10.0.0.0/16",
        "description": "The VPC's private address range, /16 to /20. Subnets are /20s of a /16, scaled down for smaller ranges."
      },
      "az_count": {
        "type": "integer",
        "minimum": 2,
        "maximum": 3,
        "default": 2,
        "description": "Availability zones to spread the subnets across."
      },
      "single_nat": {
        "type": "boolean",
        "default": true,
        "description": "One NAT gateway shared by every zone (cheaper). False puts one in each zone, so a zone outage does not cut the others off."
      },
      "flow_log_retention_days": {
        "type": "integer",
        "enum": [
          7,
          14,
          30,
          60,
          90,
          180,
          365
        ],
        "default": 30,
        "description": "Days CloudWatch keeps flow log records."
      },
      "delivery": {
        "type": "string",
        "enum": [
          "github-actions"
        ],
        "default": "github-actions",
        "description": "What plans and applies the project. Must match the repository's host."
      },
      "backend": {
        "type": "string",
        "enum": [
          "r2",
          "tfc"
        ],
        "default": "r2"
      },
      "tfc_organization": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,90}$"
      },
      "tfc_workspace": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,90}$"
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "backend": {
              "const": "tfc"
            }
          },
          "required": [
            "backend"
          ]
        },
        "then": {
          "required": [
            "tfc_organization"
          ]
        }
      }
    ]
  },
  "example": {
    "name": "acme-prod"
  },
  "rendered": [
    {
      "path": "infra/network-baseline/main.tf",
      "template": "main.tf.tmpl"
    },
    {
      "path": "infra/network-baseline/backend.tf",
      "template": "backend-r2.tf.tmpl",
      "when": {
        "backend": "r2"
      }
    },
    {
      "path": "infra/network-baseline/backend.tf",
      "template": "backend-tfc.tf.tmpl",
      "when": {
        "backend": "tfc"
      }
    },
    {
      "path": "infra/network-baseline/backend.r2.hcl.example",
      "template": "backend.r2.hcl.example.tmpl",
      "when": {
        "backend": "r2"
      }
    },
    {
      "path": "infra/network-baseline/bootstrap/main.tf",
      "template": "bootstrap-main.tf.tmpl",
      "when": {
        "backend": "r2"
      }
    },
    {
      "path": "infra/network-baseline/README.md",
      "template": "README.md.tmpl"
    }
  ]
}
