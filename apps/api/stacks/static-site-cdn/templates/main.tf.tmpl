# GENERATED by infralift from the static-site-cdn stack. main.tf and
# backend.tf are rewritten when the project's settings change in infralift;
# modules/ is rewritten when the stack changes. Add your own resources in a
# file of your own in this directory, which infralift never touches.

terraform {
  required_version = ">= 1.6"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

# Credentials come from the environment (AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY, or anything else the AWS SDK reads), never a file.
provider "aws" {
  region = "{{region}}"

  default_tags {
    tags = local.tags
  }
}

# The certificate CloudFront serves must come from us-east-1.
provider "aws" {
  alias  = "us_east_1"
  region = "us-east-1"

  default_tags {
    tags = local.tags
  }
}

locals {
  tags = {
    managed-by        = "infralift"
    infralift-stack   = "static-site-cdn"
    infralift-project = "{{name}}"
  }
}

module "site_bucket" {
  source = "./modules/site-bucket"

  name = "{{name}}"
}

module "cdn" {
  source = "./modules/cdn"
  providers = {
    aws           = aws
    aws.us_east_1 = aws.us_east_1
  }

  name                        = "{{name}}"
  domain                      = "{{domain}}"
  zone_name                   = "{{zone}}"
  price_class                 = "{{price_class}}"
  bucket                      = module.site_bucket.bucket
  bucket_arn                  = module.site_bucket.arn
  bucket_regional_domain_name = module.site_bucket.regional_domain_name
}
