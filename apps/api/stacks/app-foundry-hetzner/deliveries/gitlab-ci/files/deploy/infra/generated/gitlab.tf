# GENERATED by infralift.
#
# Everything the GitLab pipeline needs is written straight into the project's
# CI/CD variables, so no credential is ever copied by hand. These values are
# in state, which is why the R2 backend encrypts it.
#
# Variables are not protected: review apps run on merge request branches,
# which are not protected branches. Pipelines from forks get none of them.

variable "gitlab_project" {
  description = "Project (full path, groups included) that receives the deploy variables, e.g. acme/platform/web."
  type        = string
}

data "gitlab_project" "this" {
  path_with_namespace = var.gitlab_project
}

locals {
  # Masked in job logs. GitLab can only mask single-line values.
  ci_masked = {
    CF_ACCESS_CLIENT_ID     = cloudflare_zero_trust_access_service_token.deploy.client_id
    CF_ACCESS_CLIENT_SECRET = cloudflare_zero_trust_access_service_token.deploy.client_secret
    R2_ACCESS_KEY_ID        = var.r2_backup_access_key_id
    R2_SECRET_ACCESS_KEY    = var.r2_backup_secret_access_key
  }

  ci_variables = {
    PROD_HOST       = local.prod_host
    SSH_HOST        = local.ssh_host
    SSH_KNOWN_HOSTS = "${local.ssh_host} ${trimspace(tls_private_key.host.public_key_openssh)}"
    PREVIEW_HOST    = "${var.subdomain}-preview-{slot}.${var.zone_name}"
    MAX_PREVIEWS    = tostring(var.max_previews)
    R2_BUCKET       = cloudflare_r2_bucket.backups.name
    R2_ENDPOINT     = "https://${var.cloudflare_account_id}.r2.cloudflarestorage.com"
  }
}

resource "gitlab_project_variable" "masked" {
  for_each = toset(nonsensitive(keys(local.ci_masked)))

  project   = data.gitlab_project.this.id
  key       = each.key
  value     = local.ci_masked[each.key]
  masked    = true
  protected = false
  raw       = true
}

# A multi-line private key cannot be masked, so it is a file variable: jobs
# get a path, and the key never appears in a job's environment or log.
resource "gitlab_project_variable" "deploy_key" {
  project       = data.gitlab_project.this.id
  key           = "DEPLOY_SSH_KEY"
  value         = tls_private_key.deploy.private_key_openssh
  variable_type = "file"
  protected     = false
  raw           = true
}

resource "gitlab_project_variable" "plain" {
  for_each = local.ci_variables

  project   = data.gitlab_project.this.id
  key       = each.key
  value     = each.value
  protected = false
  raw       = true
}

# The nightly backup. GitLab runs scheduled pipelines on a ref, so the
# schedule passes BACKUP=1 and .gitlab-ci.yml runs only the backup jobs then.
resource "gitlab_pipeline_schedule" "backup" {
  project     = data.gitlab_project.this.id
  description = "${var.name}: nightly pg_dump to R2, restored to prove it (infralift)"
  ref         = "refs/heads/${data.gitlab_project.this.default_branch}"
  cron        = "17 7 * * *"
}

resource "gitlab_pipeline_schedule_variable" "backup" {
  project              = data.gitlab_project.this.id
  pipeline_schedule_id = gitlab_pipeline_schedule.backup.pipeline_schedule_id
  key                  = "BACKUP"
  value                = "1"
}
