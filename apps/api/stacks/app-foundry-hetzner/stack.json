{
  "slug": "app-foundry-hetzner",
  "name": "app-foundry on Hetzner",
  "description": "The app-foundry template on one Hetzner server behind a Cloudflare tunnel: production, a preview per pull request, nightly backups that are restored to prove them, and SSH only through Cloudflare Access. OpenTofu with encrypted R2 state, or Terraform Cloud.",
  "template": {
    "slug": "app-foundry",
    "name": "app-foundry",
    "description": "Three React frontends (marketing, dashboard, admin), a FastAPI backend and Postgres 17.",
    "repo": "jschell12/app-foundry"
  },
  "target": {
    "slug": "hetzner",
    "name": "Hetzner Cloud"
  },
  "source": {
    "repo": "jschell12/app-foundry",
    "commit": "59416969976e220b1ccbb0918c5bdaf654b344b5"
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "zone_name",
      "subdomain",
      "github_repository"
    ],
    "properties": {
      "name": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{2,40}$",
        "description": "Prefix for every resource, and the server's name."
      },
      "zone_name": {
        "type": "string",
        "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,}$",
        "description": "Cloudflare zone the app is served from."
      },
      "subdomain": {
        "type": "string",
        "pattern": "^[a-z]([a-z0-9-]{0,28}[a-z0-9])?$",
        "description": "Production is <subdomain>.<zone>; previews and SSH hang off the same prefix."
      },
      "github_repository": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]{1,100}$",
        "description": "The app repository (name only) that receives the deploy secrets."
      },
      "location": {
        "type": "string",
        "enum": [
          "nbg1",
          "fsn1",
          "hel1"
        ],
        "default": "nbg1"
      },
      "server_type": {
        "type": "string",
        "enum": [
          "cx23",
          "cx33",
          "cx43",
          "cx53"
        ],
        "default": "cx23"
      },
      "data_volume_gb": {
        "type": "integer",
        "minimum": 10,
        "maximum": 1000,
        "default": 10
      },
      "backup_retention_days": {
        "type": "integer",
        "minimum": 1,
        "maximum": 365,
        "default": 30
      },
      "max_previews": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10,
        "default": 3
      },
      "backend": {
        "type": "string",
        "enum": [
          "r2",
          "tfc"
        ],
        "default": "r2"
      },
      "tfc_organization": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,90}$"
      },
      "tfc_workspace": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,90}$"
      }
    },
    "if": {
      "properties": {
        "backend": {
          "const": "tfc"
        }
      },
      "required": [
        "backend"
      ]
    },
    "then": {
      "required": [
        "tfc_organization"
      ]
    }
  },
  "example": {
    "name": "app-foundry-demo",
    "zone_name": "infralift.dev",
    "subdomain": "demo",
    "github_repository": "app-foundry"
  },
  "rendered": [
    {
      "path": "deploy/infra/main.tf",
      "template": "main.tf.tmpl"
    },
    {
      "path": "deploy/infra/backend.tf",
      "template": "backend-r2.tf.tmpl",
      "when": {
        "backend": "r2"
      }
    },
    {
      "path": "deploy/infra/backend.tf",
      "template": "backend-tfc.tf.tmpl",
      "when": {
        "backend": "tfc"
      }
    },
    {
      "path": "deploy/infra/backend.r2.hcl.example",
      "template": "backend.r2.hcl.example.tmpl",
      "when": {
        "backend": "r2"
      }
    },
    {
      "path": "deploy/bootstrap/main.tf",
      "template": "bootstrap-main.tf.tmpl",
      "when": {
        "backend": "r2"
      }
    },
    {
      "path": "deploy/README.md",
      "template": "README.md.tmpl"
    }
  ],
  "exclude": [
    {
      "prefix": "deploy/bootstrap/",
      "when": {
        "backend": "tfc"
      }
    }
  ],
  "seed": [
    "deploy/infra/overrides.tf"
  ]
}
