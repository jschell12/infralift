# GENERATED by infralift. Everything in deploy/infra except overrides.tf
# and terraform.tfvars is rewritten when the project changes in the UI.

terraform {
  required_version = ">= 1.6"

  required_providers {
    hcloud = {
      source = "hetznercloud/hcloud"
    }
    cloudflare = {
      source = "cloudflare/cloudflare"
    }
{{#if delivery_github}}    github = {
      source = "integrations/github"
    }
{{/if}}{{#if delivery_gitlab}}    gitlab = {
      source = "gitlabhq/gitlab"
    }
{{/if}}  }
}

# Credentials come from the environment, never from files:
{{#if delivery_github}}#   HCLOUD_TOKEN, CLOUDFLARE_API_TOKEN, GITHUB_TOKEN (+ GITHUB_OWNER)
{{/if}}{{#if delivery_gitlab}}#   HCLOUD_TOKEN, CLOUDFLARE_API_TOKEN, GITLAB_TOKEN
{{/if}}provider "hcloud" {}
provider "cloudflare" {}
{{#if delivery_github}}provider "github" {}
{{/if}}{{#if delivery_gitlab}}provider "gitlab" {}
{{/if}}
locals {
  # What the UI chose. overrides.tf wins on any key it sets.
  ui_settings = {
    name                  = "{{name}}"
    zone_name             = "{{zone_name}}"
    subdomain             = "{{subdomain}}"
{{#if delivery_github}}    github_repository     = "{{github_repository}}"
{{/if}}{{#if delivery_gitlab}}    gitlab_project        = "{{gitlab_project}}"
{{/if}}    location              = "{{location}}"
    server_type           = "{{server_type}}"
    data_volume_gb        = {{data_volume_gb}}
    backup_retention_days = {{backup_retention_days}}
    max_previews          = {{max_previews}}
  }

  settings = merge(local.ui_settings, local.overrides)
}

module "app" {
  source = "./generated"

  cloudflare_account_id = var.cloudflare_account_id
  admin_emails          = var.admin_emails

  r2_backup_access_key_id     = var.r2_backup_access_key_id
  r2_backup_secret_access_key = var.r2_backup_secret_access_key

  name                  = local.settings.name
  zone_name             = local.settings.zone_name
  subdomain             = local.settings.subdomain
{{#if delivery_github}}  github_repository     = local.settings.github_repository
{{/if}}{{#if delivery_gitlab}}  gitlab_project        = local.settings.gitlab_project
{{/if}}  location              = local.settings.location
  server_type           = local.settings.server_type
  data_volume_gb        = local.settings.data_volume_gb
  backup_retention_days = local.settings.backup_retention_days
  max_previews          = local.settings.max_previews
  labels                = local.extra_labels
}
