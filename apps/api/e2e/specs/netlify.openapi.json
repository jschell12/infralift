  "/user": {
   "get": {
    "operationId": "getCurrentUser",
    "summary": "Get the current user",
    "tags": [
     "user"
    ],
    "parameters": [],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/user"
        },
        "examples": {
         "e2e": {
          "summary": "infralift e2e seed (e2e/specs/seeds/netlify.ts)",
          "value": {
           "id": "e2e0user00000000000000001",
           "email": "e2e@infralift-e2e-netlify.example"
          }
         }
        }
       }
      }
     },
     "default": {
      "description": "error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/error"
        }
       }
      }
     }
    }
   }
  },
  "/sites": {
   "get": {
    "operationId": "listSites",
    "summary": "List sites",
    "tags": [
     "site"
    ],
    "description": "**Note:** Environment variable keys and values have moved from `build_settings.env` and `repo.env` to a new endpoint. Please use [getEnvVars](#tag/environmentVariables/operation/getEnvVars) to retrieve site environment variables.",
    "parameters": [
     {
      "name": "name",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "filter",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "enum": [
        "all",
        "owner",
        "guest"
       ]
      }
     },
     {
      "name": "page",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "format": "int32"
      }
     },
     {
      "name": "per_page",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "format": "int32"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/site"
         }
        },
        "examples": {
         "e2e": {
          "summary": "infralift e2e seed (e2e/specs/seeds/netlify.ts)",
          "value": [
           {
            "id": "e2e0a0a0-0000-4000-8000-000000000201",
            "name": "infralift-e2e-site",
            "custom_domain": "www.infralift-e2e-netlify.example",
            "build_settings": {
             "repo_url": "https://github.com/infralift-e2e/site",
             "dir": "dist",
             "cmd": "npm run build",
             "functions_dir": "netlify/functions"
            }
           }
          ]
         }
        }
       }
      }
     },
     "default": {
      "description": "error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/error"
        }
       }
      }
     }
    }
   }
  },
  "/dns_zones": {
   "get": {
    "operationId": "getDnsZones",
    "summary": "List DNS zones",
    "description": "Returns the DNS zones for the team given by `account_slug`, or all DNS zones the current user can access.",
    "tags": [
     "dnsZone"
    ],
    "parameters": [
     {
      "name": "account_slug",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "get all DNS zones the user has access to",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/dnsZones"
        },
        "examples": {
         "e2e": {
          "summary": "infralift e2e seed (e2e/specs/seeds/netlify.ts)",
          "value": [
           {
            "id": "e2e0zone00000000000000001",
            "name": "infralift-e2e-netlify.example",
            "records": []
           }
          ]
         }
        }
       }
      }
     },
     "default": {
      "description": "error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/error"
        }
       }
      }
     }
    }
   }
  },
  "/sites/{site_id}/build_hooks": {
   "get": {
    "operationId": "listSiteBuildHooks",
    "summary": "List a site's build hooks",
    "tags": [
     "buildHook"
    ],
    "parameters": [
     {
      "name": "site_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/buildHook"
         }
        },
        "examples": {
         "e2e": {
          "summary": "infralift e2e seed (e2e/specs/seeds/netlify.ts)",
          "value": [
           {
            "id": "e2e0hook00000000000000001",
            "title": "deploy",
            "branch": "main",
            "url": "https://api.netlify.com/build_hooks/e2e0hook00000000000000001"
           }
          ]
         }
        }
       }
      }
     },
     "default": {
      "description": "error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/error"
        }
       }
      }
     }
    }
   }
  }
