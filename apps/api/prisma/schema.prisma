generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Org {
  id          String   @id @default(cuid())
  name        String
  // Cleared for delivery: full generated Terraform rather than a sample.
  // Set by an admin today; a payment webhook can set it later without
  // touching the call sites. See migration 0010.
  codegenUnlocked Boolean @default(false)
  // The sts:ExternalId this org's AWS roles must require. Minted once, on
  // first use, and never sent to another org. See migration 0024.
  awsExternalId String? @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  connections ProviderConnection[]
  assessments Assessment[]
  migrations  Migration[]
  workspaces  Workspace[]
  templates   TfTemplate[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  orgId     String
  createdAt DateTime @default(now())

  org         Org          @relation(fields: [orgId], references: [id])
  loginTokens LoginToken[]
}

// Magic-link auth: short-lived single-use tokens.
model LoginToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

// Read-only provider credentials. Token stored encrypted at rest
// (AES-256-GCM via TOKEN_ENCRYPTION_KEY); never returned by the API.
model ProviderConnection {
  id             String    @id @default(cuid())
  orgId          String
  provider       String // vercel | cloudflare | heroku | aws
  label          String
  encryptedToken String
  status         String    @default("unverified") // unverified | valid | invalid
  lastVerifiedAt DateTime?
  // Why it is invalid, in words a customer can act on. Never a provider
  // response body. Cleared by a verify that succeeds. See migration 0020.
  lastError      String?
  // When the provider says the credential stops working, if it says so
  // cheaply on the verify call (Cloudflare, GitHub). Null = unknown or never.
  expiresAt      DateTime?
  // tfc only: the VCS OAuth token (ot-...) in that organization that
  // workspaces are linked through. An id, not a secret. See migration 0021.
  vcsOauthTokenId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  org         Org          @relation(fields: [orgId], references: [id])
  assessments Assessment[]
  workspaces  Workspace[]

  @@unique([orgId, provider, label])
}

model Assessment {
  id                          String    @id @default(cuid())
  orgId                       String
  // Null for bundle-sourced assessments: there is no token, so there is no
  // ProviderConnection. See migration 0009.
  connectionId                String?
  provider                    String
  // "api" (we called the provider) | "bundle" (customer ran the collector).
  source                      String    @default("api")
  collectorVersion            String?
  collectedAt                 DateTime?
  status                      String    @default("pending") // pending | running | completed | failed
  startedAt                   DateTime?
  completedAt                 DateTime?
  error                       String?
  resourceCount               Int       @default(0)
  estimatedMonthlyCostCents   Int?
  // The monthly bill as the customer told us, which beats the inventory
  // priced at list rates. Null until they say. See migration 0018.
  reportedMonthlySpendCents   Int?
  createdAt                   DateTime  @default(now())

  org        Org                @relation(fields: [orgId], references: [id])
  connection ProviderConnection? @relation(fields: [connectionId], references: [id])
  inventory  InventoryItem[]
  findings   Finding[]
  tfProjects TfProject[]
}

model InventoryItem {
  id               String @id @default(cuid())
  assessmentId     String
  provider         String
  type             String
  externalId       String
  name             String
  region           String?
  monthlyCostCents Int?
  metadata         Json?

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

model Finding {
  id                  String  @id @default(cuid())
  assessmentId        String
  category            String // inventory | cost | risk | iac_standard | recommendation
  severity            String // info | low | medium | high
  title               String
  detail              String
  monthlySavingsCents Int?
  resourceRef         String?

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

model Migration {
  id             String   @id @default(cuid())
  orgId          String
  sourceProvider String
  targetPlatform String // cloudflare | vps
  status         String   @default("proposed") // proposed | approved | in_progress | verifying | completed | cancelled
  fixedFeeCents  Int?
  repoUrl        String?
  tfcOrg         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org    Org              @relation(fields: [orgId], references: [id])
  phases MigrationPhase[]
}

model MigrationPhase {
  id          String    @id @default(cuid())
  migrationId String
  key         String
  title       String
  order       Int
  status      String    @default("pending") // pending | in_progress | completed | blocked
  completedAt DateTime?
  notes       String?

  migration Migration @relation(fields: [migrationId], references: [id], onDelete: Cascade)

  @@unique([migrationId, key])
}

model Workspace {
  id              String    @id @default(cuid())
  orgId           String
  name            String
  tfcWorkspaceUrl String?
  driftDetected   Boolean   @default(false)
  lastRunStatus   String?
  lastRunAt       DateTime?
  createdAt       DateTime  @default(now())

  // A project is backed by one or more workspaces. Null for workspaces
  // recorded before projects owned them.
  projectId         String?
  // adopted   - imported from the customer's HCP Terraform / TFE org. Their
  //             code, their state, frozen: infralift never pushes upgrades.
  // managed   - created by infralift: a template, codegen or stack job.
  //             A job that finds the workspace already there records it as
  //             adopted instead, so infralift leaves its settings alone.
  // extension - added to a project to hold new infrastructure, reading
  //             outputs from the workspaces it depends on.
  kind              String  @default("managed")
  // The customer's TFC/TFE connection (ProviderConnection provider "tfc").
  // Adopted and extension workspaces live in their org. Projects rendered
  // through the /tf/jobs pipeline still use infralift's own TFC_ORG.
  connectionId      String?
  tfcWorkspaceId    String?
  vcsRepo           String?
  workingDirectory  String?
  // Commit of the configuration version current when the workspace was
  // adopted. Pins the adopted template's module source.
  configCommitSha   String?
  // Variable snapshot: [{key, category, hcl, sensitive, description, value?}].
  // Sensitive values are never stored, only that the key exists.
  inputs            Json    @default("[]")
  // [{name, sensitive}] from the current state version. What extensions can
  // wire to.
  outputs           Json    @default("[]")
  templateVersionId String?

  org             Org                   @relation(fields: [orgId], references: [id])
  project         TfProject?            @relation(fields: [projectId], references: [id])
  connection      ProviderConnection?   @relation(fields: [connectionId], references: [id])
  templateVersion TfTemplateVersion?    @relation(fields: [templateVersionId], references: [id])
  dependsOn       WorkspaceDependency[] @relation("dependent")
  dependents      WorkspaceDependency[] @relation("base")

  @@unique([orgId, name])
  // A job records the workspace it created or reused by this key, so a rerun
  // finds its row instead of adding one (lib/tf/workspace-record.ts).
  @@unique([orgId, tfcWorkspaceId])
  @@index([projectId])
}

// An extension workspace reading outputs from a base workspace. One row per
// (extension, base) pair; `outputs` maps the extension's local name to the
// base's output name.
model WorkspaceDependency {
  id          String   @id @default(cuid())
  workspaceId String
  dependsOnId String
  outputs     Json     @default("{}")
  createdAt   DateTime @default(now())

  workspace Workspace @relation("dependent", fields: [workspaceId], references: [id], onDelete: Cascade)
  dependsOn Workspace @relation("base", fields: [dependsOnId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, dependsOnId])
  @@index([dependsOnId])
}

// ---------------------------------------------------------------------------
// Hosting provider catalog + "find a better home for my app" recommendation
// model. Catalog rows are seeded (prisma/seed.ts); AppProfile captures a
// customer's workload requirements, and the /recommendations endpoint scores
// providers against a profile in SQL.
// ---------------------------------------------------------------------------

model HostingProvider {
  id             String  @id @default(cuid())
  slug           String  @unique
  name           String
  // paas | frontend_cloud | edge | hyperscaler | vps | container | static
  category       String
  websiteUrl     String
  // free_tier | per_seat | usage | fixed | hybrid
  pricingModel   String
  // Cheapest paid entry point, USD cents/month (0 = usable free tier)
  minMonthlyCents Int
  // What a typical small production app actually costs per month
  typicalMonthlyCents Int
  benefits       String
  drawbacks      String
  // 0 = you run everything, 3 = fully managed
  managedLevel   Int
  // Free egress allowance in GB/month (-1 = unmetered)
  egressFreeGb   Int     @default(0)
  notes          String?

  capabilities     ProviderCapability[]
  plans            ProviderPlan[]
  discountPrograms DiscountProgram[]
}

// A way to pay less than list price on a provider: startup credits,
// committed-spend/enterprise agreements, or published mechanisms like
// Hetzner's server auction. Data is research-sourced; `confidence` tracks
// how well each program's numbers are corroborated.
model DiscountProgram {
  id         String @id @default(cuid())
  providerId String
  // startup_credit | committed_spend | auction
  kind       String
  name       String

  // startup_credit fields
  creditMaxCents        Int?
  creditDurationMonths  Int?
  // use-it-or-lose-it monthly allocation (null = lump-sum pool)
  creditMonthlyCapCents Int?

  // corroborated | advisor | anecdote | unverified
  confidence String
  sourceNote String?
  // when the numbers were last verified, e.g. "2026-08"
  sourceDate String?
  notes      String?

  provider HostingProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  tiers    DiscountTier[]

  @@unique([providerId, name])
}

// Commit-size → discount curve for committed_spend (and auction) programs.
// Commit is whole USD/year (not cents) so $50M+ tiers fit in an Int.
model DiscountTier {
  id                 String @id @default(cuid())
  programId          String
  minAnnualCommitUsd Int
  // discount in basis points (1500 = 15% off list)
  discountBps        Int

  program DiscountProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, minAnnualCommitUsd])
}

// Capability score per provider: 0 = unsupported, 1 = partial/workaround,
// 2 = supported, 3 = best-in-class. Keys are stable strings, e.g.
// static_hosting, ssr, full_node_runtime, containers, background_workers,
// cron, websockets, managed_postgres, object_storage, edge_network,
// autoscaling, zero_devops, terraform_provider, gpu.
model ProviderCapability {
  id         String @id @default(cuid())
  providerId String
  key        String
  score      Int

  provider HostingProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, key])
  @@index([key])
}

model ProviderPlan {
  id           String  @id @default(cuid())
  providerId   String
  name         String
  monthlyCents Int
  // seat | app | vm | dyno | usage | flat
  unit         String
  includedNotes String

  provider HostingProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, name])
}

// A customer's app described as requirements. requiredCapabilities are hard
// filters (provider must score >= 2); preferredCapabilities add to the score.
model AppProfile {
  id                    String   @id @default(cuid())
  orgId                 String
  name                  String
  // static | ssr | node_server | container | serverless_fn
  runtime               String
  requiredCapabilities  String[]
  preferredCapabilities String[]
  budgetMonthlyCents    Int
  // 0 = wants zero devops … 3 = happy to run servers
  opsTolerance          Int      @default(1)
  trafficGbMonth        Int      @default(10)
  // Current all-in annual spend, as the customer described it. Not used to
  // size committed-spend discounts: those qualify on spend on the target.
  annualSpendCents      Int?
  // Startup-credit eligibility (early stage, funded, no prior credits)
  startupCreditsEligible Boolean @default(false)
  createdAt             DateTime @default(now())

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Terraform code generation. Templates are versioned snapshots (body + JSON
// Schema stored in the DB so renders stay reproducible), Projects bind a
// template version to a destination repo/path, Renderings are generated .tf
// files, and Jobs run the staged pipeline:
//   queued -> render -> commit -> workspace -> complete
// ---------------------------------------------------------------------------

model TfTemplate {
  id          String   @id @default(cuid())
  // Null = the shared catalog every org builds from. Set = private to that
  // org, which is what an adopted workspace's template is: it points at the
  // customer's own repo and must never show up in another org's catalog.
  orgId       String?
  slug        String   @unique
  name        String
  description String
  language    String   @default("hcl")
  createdAt   DateTime @default(now())

  org      Org?                @relation(fields: [orgId], references: [id], onDelete: Restrict)
  versions TfTemplateVersion[]

  @@index([orgId])
}

model TfTemplateVersion {
  id           String   @id @default(cuid())
  templateId   String
  releaseTag   String
  // Full template body snapshot; placeholders + conditional blocks.
  templateBody String
  // JSON Schema (draft 2020-12) describing render inputs.
  inputSchema  Json
  createdAt    DateTime @default(now())

  template   TfTemplate  @relation(fields: [templateId], references: [id])
  projects   TfProject[]
  renderings TfRendering[]
  workspaces Workspace[]

  @@unique([templateId, releaseTag])
}

model TfProject {
  id     String @id @default(cuid())
  orgId  String
  name   String
  // template | codegen | adopted | stack | imported. A stack project renders a whole
  // deploy setup (apps/api/stacks/<stackSlug>) into the customer's app repo
  // and lands it as a pull request. A codegen project is generated from an
  // assessment and has no template version; a template project has no
  // assessment. An adopted project was built around workspaces imported from
  // the customer's TFC org; destRepo is the first adopted workspace's VCS repo,
  // or "" when it was CLI-driven and has none.
  source String @default("template")
  // Null for codegen projects.
  templateVersionId String?
  // Set for codegen projects: the assessment whose inventory produced the HCL.
  assessmentId      String?
  // cloudflare | hetzner, for codegen projects.
  migrationTarget   String?
  // Set for stack projects: the directory under apps/api/stacks.
  stackSlug         String?
  // Set for imported projects: the scan of the root module at destPath
  // (lib/import/scan.ts RootModule). The job adds a read-only plan check.
  importJson        Json?
  // Last result of that check, read back from GitHub (lib/import/result.ts).
  importCheckJson   Json?
  // Where destRepo lives (github | gitlab), and which of the org's
  // connections to use there. Null connection = the org's first one.
  gitHost           String   @default("github")
  gitConnectionId   String?
  // Greenfield: create destRepo from the stack's app template on the next
  // job, then clear this.
  createRepo        Boolean  @default(false)
  // The org's Terraform Cloud connection the project's workspace lives in
  // (ProviderConnection, provider "tfc"). Null = no workspace is created.
  tfcConnectionId   String?
  destRepo          String // owner/repo
  destPath          String   @default("") // work dir inside repo, "" = root
  destBranch        String   @default("main")
  // Provider pinning for the generated provider.tf (name, source, version, region)
  providerConfig    Json
  createdAt         DateTime @default(now())

  templateVersion TfTemplateVersion? @relation(fields: [templateVersionId], references: [id])
  assessment      Assessment?        @relation(fields: [assessmentId], references: [id])
  renderings      TfRendering[]
  jobs            TfJob[]
  workspaces      Workspace[]

  @@unique([orgId, name])
  @@index([assessmentId])
}

model TfRendering {
  id                String   @id @default(cuid())
  projectId         String
  // Null for codegen renderings, which come from an assessment rather than a
  // template version.
  templateVersionId String?
  fileName          String
  argumentsJson     Json
  renderedBody      String
  commitSha         String?
  managed           Boolean  @default(true)
  createdAt         DateTime @default(now())

  project         TfProject          @relation(fields: [projectId], references: [id])
  templateVersion TfTemplateVersion? @relation(fields: [templateVersionId], references: [id])
  jobs            TfJob[]

  @@unique([projectId, fileName])
}

model TfJob {
  id            String   @id @default(cuid())
  projectId     String
  // template | codegen | stack | import
  kind          String   @default("template")
  // queued | render | commit | workspace | complete
  stage         String   @default("queued")
  // pending | running | errored | success
  status        String   @default("pending")
  statusMessage String   @default("") // short human-readable, <= 280 chars
  argumentsJson Json     @default("{}")
  // Template jobs render exactly one file. Codegen jobs write a whole
  // directory, so the commit is recorded on the job rather than on a single
  // rendering.
  renderingId   String?
  commitSha     String?
  fileCount     Int      @default(0)
  workspaceName String?
  // Stack jobs land as a pull request rather than a push to destBranch.
  prUrl         String?
  // Queue (lib/jobs/queue.ts): set once, by the one process that runs it.
  claimedAt     DateTime?
  claimedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project   TfProject    @relation(fields: [projectId], references: [id])
  rendering TfRendering? @relation(fields: [renderingId], references: [id])

  @@index([projectId, createdAt])
  @@index([status, claimedAt])
}

// Communities and forums where infralift's target audience discusses
// cloud costs, migrations, and hosting decisions. Global reference data.
model CommunitySource {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  platform    String   // reddit, hackernews, discord, slack, forum, blog, stackexchange, vendor
  url         String
  category    String   // cloud, devops, selfhosting, frontend, startup, general
  audience    String
  relevance   String
  memberCount Int?
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())

  leads CommunityLead[]

  @@index([platform])
  @@index([category])
}

// Posts from communities classified as potential leads (billing pain,
// migration interest, platform complaints). Populated by the scanner.
model CommunityLead {
  id              String    @id @default(cuid())
  communityId     String
  sourceUrl       String
  sourceId        String
  platform        String
  title           String
  body            String    @db.Text
  authorName      String?
  classification  String    // billing_pain, migration_interest, platform_complaint
  confidence      String    // high, medium, low
  engagementScore Int?
  providers       String[]  @default([]) // source providers mentioned: vercel, heroku, firebase, aws, etc.
  status          String    @default("new") // new, contacted, dismissed, converted
  notes           String?
  postedAt        DateTime?
  scrapedAt       DateTime  @default(now())

  community CommunitySource @relation(fields: [communityId], references: [id])

  @@unique([sourceId, platform])
  @@index([communityId])
  @@index([classification])
  @@index([status])
  @@index([scrapedAt])
}

// Daily marketing-site analytics rollups. Populated by the in-process
// rollup job (src/analytics/rollup.ts) from the Workers Analytics Engine
// dataset `marketing_analytics`. One row per (date, dimension, key):
//   dimension "total"   key ""          — site-wide views/visitors
//   dimension "channel" key <channel>   — hn, reddit, google, direct, ...
//   dimension "path"    key <path>      — per-page views (visitors = 0)
model AnalyticsDaily {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  dimension String
  key       String   @default("")
  views     Int
  visitors  Int
  createdAt DateTime @default(now())

  @@unique([date, dimension, key])
}

// Someone who asked us for an assessment, from the marketing site.
//
// Deliberately separate from CommunityLead. That model is shaped for a scraped
// forum post (community FK, sourceUrl, engagementScore, a classification from
// the scanner's three buckets) and carries no email, so reusing it would mean
// a synthetic CommunitySource, a fake sourceId to satisfy its unique key, and
// an email smuggled into authorName. Every admin query over that table would
// then be counting two different things.
model InboundLead {
  id        String   @id @default(cuid())
  email     String
  name      String?
  company   String?
  // Provider they want to leave, when they told us. Free text: this is the
  // customer's word for it, not a validated Provider enum.
  provider  String?
  monthlySpend String?
  message   String?  @db.Text
  // new | contacted | qualified | dismissed | converted
  status    String   @default("new")
  notes     String?
  // Attribution, captured from the page that submitted the form.
  sourcePath String?
  referrer   String?
  utmSource  String?
  utmMedium  String?
  utmCampaign String?
  country    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}
