# Cache rules for the static assets this Worker serves (not for responses the
# Worker script itself builds, such as /a/e).
#
# Everything under /_next/static/ has a content hash in its filename, so a new
# build ships new URLs and these can be cached for a year without revalidating.
#
# HTML is deliberately not listed. Cloudflare already sends
# `public, max-age=0, must-revalidate` plus an ETag for every asset without a
# rule, which is the short caching HTML wants: a revalidation is a cheap 304,
# and a page cached longer than one deploy would point at hashed chunks the
# next deploy no longer serves. A `/*` rule here would also match
# /_next/static/*, and Cloudflare joins the two values with a comma.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
